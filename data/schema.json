{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/malta-trip-guide.schema.json",
  "title": "Malta trip-guide page data",
  "type": "object",
  "required": ["topic", "title", "intro", "date_checked", "sections"],
  "properties": {
    "topic": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "intro": {"type": "string", "minLength": 1},
    "date_checked": {"type": "string", "format": "date"},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "lead": {"type": "string"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/item"}
          }
        },
        "additionalProperties": true
      }
    },
    "planner": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id", "name", "category", "area", "address", "hours", "price_range",
        "description", "source_url", "source_type", "date_checked", "confidence", "notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "hours": {"type": "string", "minLength": 1},
        "price_range": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["official", "map", "review", "social"]},
        "date_checked": {"type": "string", "format": "date"},
        "confidence": {"enum": ["verified", "partially verified", "unverified"]},
        "notes": {"type": "string"},
        "supporting_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "url", "source_type"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "url": {"type": "string", "minLength": 1},
              "source_type": {"enum": ["official", "map", "review", "social"]},
              "date_checked": {"type": "string", "format": "date"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
